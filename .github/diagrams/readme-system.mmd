flowchart TB
  subgraph app["Hashi, in your browser"]
    direction LR
    card["Swap screen<br/>every route priced · every fee shown"]
    runner["Swap runner<br/>each step saved in this browser"]
    card --> runner
  end
  subgraph money["Your dollars"]
    direction LR
    stable["Your EVM or Solana wallet<br/>USDC · USDT on eight chains"]
    bridge["NEAR Intents or THORChain<br/>carries them as BCH"]
    bchw["Your Bitcoin Cash wallet"]
    cauldron["Cauldron<br/>BCH ⇄ PUSD · MUSD"]
    done(["PUSD · MUSD · BCH<br/>in your own wallet"])
    stable == "1 · deposit" ==> bridge
    bridge == "2 · BCH" ==> bchw
    bchw == "3 · swap" ==> cauldron
    cauldron == "4" ==> done
  end
  subgraph helpers["Also used"]
    direction LR
    appkit["Reown AppKit<br/>WalletConnect"]
    wiz["WizardConnect"]
    electrum["Electrum servers<br/>coins · broadcast"]
    relay["Hashi relayer<br/>pays Base gas for USDC"]
  end
  card -. "quotes" .-> bridge
  card -. "quotes · builds" .-> cauldron
  runner -. "approve" .-> stable
  runner -. "approve" .-> bchw
  appkit -.- stable
  wiz -.- bchw
  electrum -.- bchw
  relay -.- bridge
