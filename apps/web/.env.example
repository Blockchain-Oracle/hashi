# Hashi's web app. Next.js reads env files from this directory (apps/web), not the repo root.
# NEXT_PUBLIC_* values are public and inlined into the browser bundle at build time (in Docker: build arguments).

# Where the site is served. Empty means https://hashi.cash.
NEXT_PUBLIC_SITE_URL=
# The docs site. Empty means https://docs.hashi.cash.
NEXT_PUBLIC_DOCS_URL=

# Reown (WalletConnect) project id, for connecting EVM and Solana wallets. Free at https://dashboard.reown.com.
# Add http://localhost:3030 and the production domain to the project's allowed domains.
NEXT_PUBLIC_REOWN_PROJECT_ID=

# Server only, read at runtime (in Coolify: a runtime variable, never a build argument).
# The gas relayer's key: it pays Base gas for gasless USDC deposits and holds about $1 of ETH, never anyone's
# money. Without it the relayer answers "not set up" and the swap screen offers the normal deposit.
RELAYER_PRIVATE_KEY=
# Optional Base RPC for the relayer; viem's public endpoint is used without it.
BASE_RPC_URL=
