{
  "name": "hashi",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @hashi/web dev",
    "build": "pnpm --filter @hashi/web build",
    "start": "pnpm --filter @hashi/web start",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "5.1.0"
  }
}
